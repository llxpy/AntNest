{
  "api": {
    "base_url": "https://api.deepseek.com/v1",
    "model_name": "deepseek-chat",
    "api_key": "",
    "thinking_mode": "auto",
    "skip_model_check": false,
    "default_token_cap": 128000
  },
  "agent": {
    "max_depth": 2,
    "max_clones": {
      "0": 10,
      "1": 5,
      "2": 3
    },
    "compact_threshold": 0.85,
    "tool_result_max_len": 8000,
    "worker_timeout": 300
  }
}
